# GitHub
GITHUB_TARGET_REPO=yamazawa/ClaudeManagementTower
GITHUB_TARGET_REPO_PATH=C:/git/ClaudeManagementTower
GITHUB_DEFAULT_BRANCH=master

# リポジトリ一覧から追加するリポジトリ（所有者が空ならSELF_REPOの所有者）
NEW_REPO_BASE_DIR=C:/git
NEW_REPO_OWNER=
# private/public/internal
NEW_REPO_VISIBILITY=private

# ワーカー
WORKER_COUNT=3
WORKTREE_BASE_DIR=C:/git/claude-tower-worktrees
WORKER_POLL_INTERVAL_SECONDS=3
JOB_HEARTBEAT_INTERVAL_SECONDS=5
JOB_STALE_TIMEOUT_SECONDS=60
WORKER_OFFLINE_TIMEOUT_SECONDS=30
WORKER_RESPAWN_DELAY_SECONDS=5
PR_SYNC_INTERVAL_SECONDS=5
RATE_LIMIT_RETRY_DELAY_SECONDS=600

# ログ（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# データベース
DATABASE_PATH=claude_tower.db

# Cloudflare Access（Phase 9で設定）
CLOUDFLARE_ACCESS_AUD=
